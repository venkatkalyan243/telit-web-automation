<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Telit - Regression Suite"
       parallel="methods"
       thread-count="2"
       verbose="1">

  <listeners>
    <listener class-name="com.telit.listener.SuiteListener"/>
    <listener class-name="com.telit.listener.TestListener"/>
    <listener class-name="com.telit.listener.RetryListener"/>
  </listeners>

  <test name="Functional Regression">
    <packages>
      <package name="com.telit.test.web"/>
      <package name="com.telit.test.api"/>
      <package name="com.telit.test.hybrid"/>
    </packages>
  </test>
</suite>
